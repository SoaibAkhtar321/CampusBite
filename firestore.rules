rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userExists() {
      return isSignedIn() && exists(userPath());
    }

    function currentUser() {
      return get(userPath());
    }

    function isAdmin() {
      return userExists()
        && currentUser().data.role == "admin"
        && currentUser().data.isBlocked != true;
    }

    function isShopkeeper() {
      return userExists()
        && currentUser().data.role == "shopkeeper"
        && currentUser().data.isApproved == true
        && currentUser().data.isBlocked != true;
    }

    function isStudent() {
      return userExists()
        && currentUser().data.role == "student"
        && currentUser().data.isBlocked != true;
    }

    function userShopId() {
      return currentUser().data.shopId;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function shopPath(shopId) {
      return /databases/$(database)/documents/shops/$(shopId);
    }

    function shopExists(shopId) {
      return shopId is string
        && shopId != ""
        && exists(shopPath(shopId));
    }

    function shopIsOrderable(shopId) {
      return shopExists(shopId)
        && get(shopPath(shopId)).data.isApproved == true
        && get(shopPath(shopId)).data.isBlocked != true
        && get(shopPath(shopId)).data.isDeleted != true
        && get(shopPath(shopId)).data.isOpen == true;
    }

    // ── users ─────────────────────────────────────────────────────────────────

    match /users/{userId} {
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role in ["student", "shopkeeper"];

      allow read: if isSignedIn()
        && (request.auth.uid == userId || isAdmin());

      allow update: if isAdmin()
        || (
          isSignedIn()
          && request.auth.uid == userId
          && changedKeys().hasOnly([
            "name", "phone", "fcmToken", "fcmTokens",
            "fcmTokenUpdatedAt", "lastSeenAt", "updatedAt"
          ])
        );

      allow delete: if isAdmin();
    }

    // ── shops ─────────────────────────────────────────────────────────────────

    match /shops/{shopId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow update: if isAdmin()
        || (
          isShopkeeper()
          && userShopId() == shopId
          && request.resource.data.shopId == resource.data.shopId
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.ownerEmail == resource.data.ownerEmail
          && request.resource.data.isApproved == resource.data.isApproved
          && request.resource.data.isBlocked == resource.data.isBlocked
          && request.resource.data.isDeleted == resource.data.isDeleted
          && request.resource.data.displayOrder == resource.data.displayOrder
          && changedKeys().hasOnly([
            "name", "description", "imageUrl", "isOpen",
            "openingTime", "closingTime", "maxOrdersPerSlot",
            "closedSlots", "upiId", "phone", "ownerPhone",
            "updatedAt", "lastActiveAt"
          ])
        );
      allow delete: if isAdmin();
    }

    // ── menuItems ─────────────────────────────────────────────────────────────

    match /menuItems/{menuItemId} {
      allow read: if isSignedIn();
      allow create: if isAdmin()
        || (
          isShopkeeper()
          && request.resource.data.itemId == menuItemId
          && request.resource.data.shopId == userShopId()
          && request.resource.data.name is string
          && request.resource.data.name != ""
          && request.resource.data.price is number
          && request.resource.data.price > 0
        );
      allow update: if isAdmin()
        || (
          isShopkeeper()
          && resource.data.shopId == userShopId()
          && request.resource.data.shopId == resource.data.shopId
          && request.resource.data.itemId == resource.data.itemId
          && (
            request.resource.data.price == resource.data.price
            || (
              request.resource.data.price is number
              && request.resource.data.price > 0
            )
          )
        );
      allow delete: if isAdmin()
        || (isShopkeeper() && resource.data.shopId == userShopId());
    }

    // ── orders ────────────────────────────────────────────────────────────────

    match /orders/{orderId} {
  // Order creation is server-only: the createOrder Cloud Function validates
  // price, shop/menu state, and slot capacity inside a transaction (using
  // the Admin SDK, which bypasses these rules) before writing the order and
  // incrementing slotAvailability atomically. Allowing any client-side
  // create here would let a client set its own totalPrice/status and skip
  // slot-capacity enforcement entirely, so it is denied unconditionally.
  allow create: if false;

  allow read: if isAdmin()
    || (isStudent() && resource.data.studentId == request.auth.uid)
    || (isShopkeeper() && resource.data.shopId == userShopId());

  allow update: if isAdmin();

  allow delete: if false;
}

    // ── slotAvailability ──────────────────────────────────────────────────────
    //
    // Slot counters are only ever mutated inside the createOrder transaction
    // via the Admin SDK (which bypasses these rules), so every counter
    // increment is paired with the order that consumed the slot. Any
    // client-side write path here (including shopkeeper/admin) would let a
    // client alter counts without a corresponding order, defeating the
    // atomic slot-locking guarantee. Writes are therefore Cloud
    // Functions/Admin SDK only; reads remain open to signed-in users so the
    // app can display live slot availability.

    match /slotAvailability/{slotId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ── shopAnalytics ─────────────────────────────────────────────────────────
    //
    // Path structure: shopAnalytics/{shopId}/{period}/{docId}
    //   period is "daily" | "monthly" | "lifetime"
    //   docId  is a date string "yyyy-MM-dd", "yyyy-MM", or "summary"
    //
    // This explicit 3-segment match covers ALL documents under the collection.
    // The previous rule was already correct — the bug was NOT here.

    match /shopAnalytics/{shopId}/{period}/{docId} {
      allow read: if isAdmin()
        || (isShopkeeper() && userShopId() == shopId);

      // Write: admin writes directly; Cloud Functions write using Admin SDK (bypass rules)
      allow write: if isAdmin();
    }

    // ── appConfig ─────────────────────────────────────────────────────────────

    match /appConfig/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── Deny everything else ──────────────────────────────────────────────────

    match /{document=**} {
      allow read, write: if false;
    }
  }
}